---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" noindex>
  <main id="main">
    <section style="padding:120px 0">
      <div class="wrap" style="max-width:640px">
        <span class="eyebrow">404</span>
        <h1 style="font-size:clamp(40px,5vw,62px);margin-bottom:18px">We couldn’t find that page</h1>
        <p style="margin-bottom:28px;color:var(--ink-soft)">It may have moved. Try one of these instead.</p>
        <a class="btn solid" href="/">Back to home</a> &nbsp; <a class="btn ghost" href="/services">See services</a>
      </div>
    </section>
  </main>
</Layout>
